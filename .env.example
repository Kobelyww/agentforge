# ===== AgentForge 环境变量示例 =====
# 复制为 .env 并按需填写。所有 LLM Key 均可选 —— 不配置任何 Key 时，
# 平台自动使用内置 Mock Provider，可完整体验 Agent / RAG / 工具调用全流程。

# ---- LLM Providers（OpenAI 兼容协议，适用于 OpenAI / GLM / Kimi / DeepSeek / Qwen 等）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 智谱 GLM
GLM_API_KEY=
GLM_MODEL=glm-4-plus

# 华为云 ModelArts MaaS（OpenAI 兼容端点）
MODELARTS_API_KEY=
MODELARTS_BASE_URL=https://api.modelarts-maas.com/v1
MODELARTS_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Server ----
AGENTFORGE_HOST=0.0.0.0
AGENTFORGE_PORT=8000
AGENTFORGE_LOG_LEVEL=INFO
# 配置后所有 /api/* 接口要求请求头 X-API-Key
AGENTFORGE_API_KEY=
# 每客户端每分钟最大请求数
AGENTFORGE_RATE_LIMIT_RPM=60
